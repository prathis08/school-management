# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRE=7d

# Server Configuration
PORT=50501
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS).
# Use * only if you really intend to allow every origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true when running behind a reverse proxy / load balancer so req.ip
# reflects the client (used by the rate limiter).
TRUST_PROXY=false

# Optional refresh-token lifetime
JWT_REFRESH_EXPIRE=7d

# httpOnly auth cookies. For cross-site deployments (separate frontend/backend
# domains over HTTPS) use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Export job/file lifetime in milliseconds (default: 1 hour)
EXPORT_TTL_MS=3600000

# Students are not allowed into this dashboard yet. Set to true only when the
# student experience is implemented.
ALLOW_STUDENT_DASHBOARD=false
